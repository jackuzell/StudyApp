# Environment variables (Crucial: never commit secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Uploaded test files (keep directory structure with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Build outputs
build/
dist/
frontend/build/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files
.DS_Store
Thumbs.db